const express = require('express');
const cors = require('cors');
const path = require('path');
const fs = require('fs');
const Imap = require('imap');
const { simpleParser } = require('mailparser');

const app = express();
const PORT = 3000;
const USERS_FILE = './users.json';

app.use(cors());
app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

function readUsers() {
  return JSON.parse(fs.readFileSync(USERS_FILE, 'utf8'));
}

function writeUsers(users) {
  fs.writeFileSync(USERS_FILE, JSON.stringify(users, null, 2));
}

app.get('/api/users', (req, res) => {
  const users = readUsers();
  res.json(users.map(({ id, name, email }) => ({ id, name, email })));
});

app.post('/api/users', (req, res) => {
  const { name, email, password, host } = req.body;

  if (!name || !email || !password) {
    return res.status(400).json({ error: 'name, email, password required' });
  }

  const users = readUsers();

  if (users.find((u) => u.email === email)) {
    return res.status(409).json({ error: 'Email already exists' });
  }

  const newUser = {
    id: 'user' + Date.now(),
    name,
    email,
    password,
    host: host || 'imap.gmail.com',
  };

  users.push(newUser);
  writeUsers(users);

  res.json({ id: newUser.id, name: newUser.name, email: newUser.email });
});

app.delete('/api/users/:id', (req, res) => {
  const users = readUsers();
  const filtered = users.filter((u) => u.id !== req.params.id);

  if (users.length === filtered.length) {
    return res.status(404).json({ error: 'User not found' });
  }

  writeUsers(filtered);
  res.json({ success: true });
});

function fetchLastEmails(user, limit = 10) {
  return new Promise((resolve, reject) => {
    const imap = new Imap({
      user: user.email,
      password: user.password,
      host: user.host || 'imap.gmail.com',
      port: 993,
      tls: true,
      tlsOptions: { rejectUnauthorized: false },
      connTimeout: 20000,
      authTimeout: 20000,
    });

    const emails = [];
    let completed = 0;

    imap.once('ready', () => {
      imap.openBox('INBOX', true, (err, box) => {
        if (err) {
          imap.end();
          return reject(err);
        }

        const total = box.messages.total;
        if (total === 0) {
          imap.end();
          return resolve([]);
        }

        const start = Math.max(1, total - limit + 1);
        const end = total;
        const expected = end - start + 1;

        const fetch = imap.seq.fetch(`${start}:${end}`, {
          bodies: '',
          struct: true,
        });

        fetch.on('message', (msg, seqno) => {
          let buffer = '';
          msg.on('body', (stream) => {
            stream.on('data', (chunk) => {
              buffer += chunk.toString('utf8');
            });
          });
          msg.once('end', async () => {
            try {
              const parsed = await simpleParser(buffer);
              emails.push({
                seqno,
                from: parsed.from?.text || '',
                to: parsed.to?.text || '',
                subject: parsed.subject || '(No Subject)',
                date: parsed.date || null,
                html: parsed.html || null,
                text: parsed.text || '',
              });
            } catch (e) {
              console.error('Parse error:', e.message);
            } finally {
              completed++;
              if (completed === expected) {
                imap.end();
              }
            }
          });
        });

        fetch.once('error', (err) => {
          imap.end();
          reject(err);
        });
      });
    });

    imap.once('error', reject);

    imap.once('end', () => {
      emails.sort((a, b) => new Date(b.date) - new Date(a.date));
      resolve(emails);
    });

    imap.connect();
  });
}

app.get('/api/emails/:userId', async (req, res) => {
  const users = readUsers();
  const user = users.find((u) => u.id === req.params.userId);

  if (!user) {
    return res.status(404).json({ error: 'User not found' });
  }

  try {
    console.log(`Fetching emails for ${user.email}`);
    const emails = await fetchLastEmails(user, 10);
    console.log(`Got ${emails.length} emails`);
    res.json({
      user: { id: user.id, name: user.name, email: user.email },
      count: emails.length,
      emails,
    });
  } catch (err) {
    console.error(`Failed for ${user.email}:`, err.message);
    res.json({
      user: { id: user.id, name: user.name, email: user.email },
      count: 0,
      emails: [],
    });
  }
});

app.listen(PORT, () => {
  console.log(`Server running at http://localhost:${PORT}`);
});